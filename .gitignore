node_modules/
out/
dist/
release/

# O uv.exe do instalador: baixado e conferido por `npm run uv`
# (scripts/baixar-uv.mjs, pinado por versao e sha256). Binario de 68 MB nao
# entra no git, e sem esta linha o release.mjs acharia "mudancas nao commitadas".
build/uv/
build/uv.novo-*/

*.tsbuildinfo

# Nunca versionar chave de API. As chaves (Gemini e Anthropic) vivem cifradas
# no settings.json do userData, fora do repositorio.
.env
.env.*

# Saidas de render e material de teste local
*.mp4
/fixtures/

.DS_Store
Thumbs.db

# Permissoes locais do Claude Code: so valem nesta maquina.
.claude/settings.local.json

# Motor de personagens (motor/): o venv (torch + CUDA, ~5 GB), o cache e os
# modelos sao desta maquina. A pasta de dados do motor pelo Studio fica no
# userData (motor/STUDIO.md); estas sao as do motor rodado a mao, do fonte.
motor/.venv/
motor/cache/
motor/models/
motor/Output/
__pycache__/
*.pyc
motor/python/
